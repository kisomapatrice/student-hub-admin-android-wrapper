<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="sh_navy">#102A43</color>
    <color name="sh_blue">#1D4ED8</color>
    <color name="sh_surface">#F7F9FC</color>
    <color name="sh_white">#FFFFFF</color>

    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/sh_blue</item>
        <item name="android:statusBarColor">@color/sh_navy</item>
        <item name="android:navigationBarColor">@color/sh_white</item>
        <item name="android:windowBackground">@color/sh_navy</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
